# TeachMe settings. Copy this file to .env.local and fill in what you need.
# Every setting is optional: TeachMe runs without any of them.
# Never put real keys in this example file; .env.local is kept out of Git.

# Web search used to check facts and find learning sources (https://tavily.com).
# Leave empty to run without web search.
TAVILY_API_KEY=

# Use a different AI model for CV Studio than the one chosen in Settings.
# Leave empty to use the Settings model.
CV_STUDIO_MODEL=

# Where the app database lives (AI provider settings, Teach Me journeys).
# Default: file:./dev.db in the project folder.
# DATABASE_URL=file:./dev.db

# Where the career database lives (CVs, applications, practice).
# Only .data/career.db (the default) is allowed.
# CV_STUDIO_DATABASE_PATH=.data/career.db

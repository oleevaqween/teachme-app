{
  "name": "teachme",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:setup": "prisma migrate deploy",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest --run",
    "test:cv": "vitest --run src/lib/cv-studio",
    "test:data-safety": "vitest --run src/lib/cv-studio/storage-path.test.ts src/lib/cv-studio/learning-handoff.test.ts",
    "test:watch": "vitest",
    "test:property": "vitest --run --config vitest.config.property.ts",
    "test:property:watch": "vitest --config vitest.config.property.ts",
    "test:all": "vitest --run && vitest --run --config vitest.config.property.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "^3.0.74",
    "@base-ui/react": "^1.6.0",
    "@libsql/client": "0.18.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tavily/core": "^0.7.6",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "docx": "^9.7.1",
    "epub2": "^3.0.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "nspell": "2.1.5",
    "officeparser": "^7.2.1",
    "pdfjs-dist": "5.6.205",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/nspell": "2.1.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fast-check": "^4.8.0",

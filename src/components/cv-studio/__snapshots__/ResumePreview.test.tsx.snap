// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CV preview columns > renders a one-column CV exactly as before 1`] = `"<article class="cv-paper executive accent-teal" data-header="plain" data-section="underline" data-display="sans" data-body="sans" data-case="upper" style="font-size:11.5px;line-height:1.45;--cv-name-size:28.749999999999996px;--cv-heading-size:11.5px;--cv-section-gap:19.549999999999997px;--accent:#175e59;--accent-tint:#edf2f1"><header data-section="profile"><h1>Ada Okoro</h1><p class="cv-profession">Project Manager</p><p class="cv-contact">ada@example.com  ·  +234 800 000 0000  ·  Lagos, Nigeria</p></header><section data-section="summary"><h2>Profile</h2><p class="cv-paragraph">Project manager supporting delivery teams.</p></section><section data-section="experience"><h2>Experience</h2><div class="cv-entry"><h3>Project Manager | Example Ltd</h3><p class="cv-meta">Lagos | 2020 - 2024</p><ul><li>Managed a budget of ₦2,000,000.</li><li>Prepared monthly reports for 4 stakeholders.</li></ul></div></section><section data-section="education"><h2>Education</h2><div class="cv-entry"><h3>BSc Management</h3><p class="cv-meta">Example University | 2019</p></div></section><section data-section="skills"><h2>Skills</h2><p class="cv-paragraph">Reporting, stakeholder management</p></section><section data-section="languages"><h2>Languages</h2><p class="cv-paragraph">French: Fluent</p></section></article>"`;
